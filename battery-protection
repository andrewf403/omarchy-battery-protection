#!/usr/bin/bash

set -euo pipefail

readonly UPOWER_SERVICE="org.freedesktop.UPower"
readonly UPOWER_INTERFACE="org.freedesktop.UPower.Device"

property_value() {
  local device="$1"
  local property="$2"
  local type=""
  local value=""

  read -r type value < <(
    /usr/bin/busctl --system get-property \
      "$UPOWER_SERVICE" "$device" "$UPOWER_INTERFACE" "$property"
  )
  printf '%s\n' "$value"
}

find_supported_battery() {
  local device=""
  local supported=""

  while IFS= read -r device; do
    [[ $device == */battery_* ]] || continue
    supported=$(property_value "$device" ChargeThresholdSupported 2>/dev/null || true)
    if [[ $supported == "true" ]]; then
      printf '%s\n' "$device"
      return 0
    fi
  done < <(/usr/bin/upower --enumerate)

  return 1
}

print_status() {
  local device="${1:-}"
  local enabled="false"
  local limit="0"

  if [[ -z $device ]]; then
    device=$(find_supported_battery || true)
  fi

  if [[ -z $device ]]; then
    printf 'available\t0\n'
    return 0
  fi

  enabled=$(property_value "$device" ChargeThresholdEnabled)
  limit=$(property_value "$device" ChargeEndThreshold)

  printf 'available\t1\n'
  printf 'enabled\t%s\n' "$([[ $enabled == "true" ]] && printf 1 || printf 0)"
  printf 'limit\t%s\n' "$limit"
  printf 'device\t%s\n' "$device"
}

sync_widget_state() {
  local enabled="$1"
  local limit="$2"
  local enabled_value=0

  [[ $enabled == "true" ]] && enabled_value=1
  if command -v omarchy-shell >/dev/null 2>&1; then
    omarchy-shell andrewf.battery-protection syncState \
      "$enabled_value" "$limit" >/dev/null 2>&1 || true
  fi
}

notify_applied_state() {
  local enabled="$1"
  local limit="$2"
  local headline="Battery protection disabled"
  local description="Charging limit set to 100%."
  local glyph="󱞝"

  if [[ $enabled == "true" ]]; then
    headline="Battery protection enabled"
    description="Charging limited to ${limit}%."
    glyph="󱞜"
  fi

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name "Battery Protection" \
      -g "$glyph" -t 4000 "$headline" "$description" >/dev/null 2>&1 || true
  fi
}

set_protection() {
  local desired="$1"
  local notify="${2:-0}"
  local device=""
  local enabled=""
  local limit=""

  device=$(find_supported_battery) || {
    echo "UPower does not report a battery with charge-threshold support" >&2
    exit 69
  }

  /usr/bin/busctl --system call \
    "$UPOWER_SERVICE" "$device" "$UPOWER_INTERFACE" \
    EnableChargeThreshold b "$desired" >/dev/null

  enabled=$(property_value "$device" ChargeThresholdEnabled)
  limit=$(property_value "$device" ChargeEndThreshold)
  print_status "$device"
  sync_widget_state "$enabled" "$limit"
  (( notify == 0 )) || notify_applied_state "$enabled" "$limit"
}

case "${1:-}" in
  status)
    print_status
    ;;
  toggle)
    notify=0
    if [[ ${2:-} == "--notify" ]]; then
      notify=1
    elif (( $# > 1 )); then
      echo "Usage: ${0##*/} toggle [--notify]" >&2
      exit 64
    fi
    device=$(find_supported_battery) || {
      echo "UPower does not report a battery with charge-threshold support" >&2
      exit 69
    }
    enabled=$(property_value "$device" ChargeThresholdEnabled)
    if [[ $enabled == "true" ]]; then
      set_protection false "$notify"
    else
      set_protection true "$notify"
    fi
    ;;
  enable)
    set_protection true
    ;;
  disable)
    set_protection false
    ;;
  supported)
    find_supported_battery >/dev/null
    ;;
  is-enabled)
    device=$(find_supported_battery) || exit 1
    [[ $(property_value "$device" ChargeThresholdEnabled) == "true" ]]
    ;;
  *)
    echo "Usage: ${0##*/} {status|toggle [--notify]|enable|disable|supported|is-enabled}" >&2
    exit 64
    ;;
esac
